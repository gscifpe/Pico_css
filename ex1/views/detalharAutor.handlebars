<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhar Autor</title>
</head>
<body>
    <h1>{{autor.nome}}</h1>
    <label>Obras escritas:</label>
    <ul>
        {{#each autor.livros}}
            <li>{{this.titulo}} - {{this.anoPublicacao}}</li>
        {{/each}}
    </ul>
</body>
</html>