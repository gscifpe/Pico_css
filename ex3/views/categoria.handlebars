<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorias</title>
</head>
<body>
    <h1>Categorias</h1>
    <a href="/categoria/cadastrar">Cadastrar Categoria</a>
    <hr>
    <ul>
        {{#each categoria}}
        <li>
            <a href="/categoria/{{this.id}}"><strong>{{this.nome}}</strong></a>
        </li>
        {{/each}}
    </ul>
</body>
</html>