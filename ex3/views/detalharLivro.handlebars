<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhar Livro</title>
</head>
<body>
    <h1>{{livro.titulo}}</h1>
    <p>Ano de Publicação: {{livro.anoPublicacao}}</p>
    <label for="icategoria">Categorias:</label>
    <ul>
        {{#each livro.categorias}}
            <li><a href="/categoria/{{this.id}}">{{this.nome}}</a></li>
        {{/each}}
    </ul>
</body>
</html>