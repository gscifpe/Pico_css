<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Livro</title>
</head>
<body>
    <h1>Cadastrar Livro</h1>
    <form action="/livro/cadastrar" method="post">
        <div>
            <label for="ititulo">Título:</label>
            <input type="text" name="titulo" id="ititulo">
        </div>
        <br>
        <div>
            <label for="ianoPublicacao">Ano de Publicação:</label>
            <input type="number" name="anoPublicacao" id="ianoPublicacao">
        </div>
        <br>
        <div>
            <label for="iautor">Autor:</label>
            <select name="autorId" id="iautor">
                {{#each autor}}
                    <option value="{{this.id}}">{{this.nome}}</option>
                {{/each}}
            </select>
        </div>
        <br>
        <button type="submit">Cadastrar</button>
    </form>
</body>
</html>