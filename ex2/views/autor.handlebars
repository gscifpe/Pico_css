<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autores</title>
</head>
<body>
    <h1>Autores</h1>
    <a href="/autor/cadastrar">Cadastrar Autor</a>
    <hr>
    <ul>
        {{#each autor}}
            <li>
                <a href="/autor/{{this.id}}"><strong>{{this.nome}}</strong></a>
            </li>
        {{/each}}    
    </ul>
        
</body>
</html>